
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PAR — The Art of Being Remembered</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

:root {
  --black: #11100e;
  --cream: #eee9df;
  --gold: #b49a72;
  --muted: #a49b8e;
  --line: rgba(238,233,223,.2);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--black);
  color: var(--cream);
  font-family: "DM Sans", sans-serif;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

img {
  display: block;
  width: 100%;
}

/* =========================
   ANNOUNCEMENT
========================= */

.announcement {
  height: 32px;
  background: #b49a72;
  color: #17140f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  letter-spacing: .28em;
  text-transform: uppercase;
}

/* =========================
   NAVIGATION
========================= */

header {
  position: absolute;
  top: 32px;
  left: 0;
  width: 100%;
  z-index: 10;
  padding: 30px 6vw;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(255,255,255,.18);
}

.logo {
  font-family: "Cormorant Garamond", serif;
  font-size: 42px;
  font-weight: 500;
  letter-spacing: .22em;
}

.nav-links {
  display: flex;
  gap: 38px;
}

.nav-links a,
.nav-right {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .2em;
}

.nav-links a {
  position: relative;
}

.nav-links a::after {
  content: "";
  position: absolute;
  bottom: -8px;
  left: 0;
  height: 1px;
  width: 0;
  background: var(--gold);
  transition: .3s;
}

.nav-links a:hover::after {
  width: 100%;
}

.nav-right {
  color: var(--gold);
}

/* =========================
   HERO
========================= */

.hero {
  min-height: 100vh;
  min-height: 100svh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background:
    linear-gradient(
      rgba(12,10,8,.42),
      rgba(12,10,8,.68)
    ),
    url("https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=2400&q=90")
    center/cover no-repeat;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at center,
    transparent 10%,
    rgba(0,0,0,.35) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 150px 20px 80px;
  animation: heroAppear 1.5s ease both;
}

.hero-kicker {
  font-size: 9px;
  letter-spacing: .45em;
  text-transform: uppercase;
  color: #d6c5a7;
  margin-bottom: 32px;
}

.hero h1 {
  font-family: "Cormorant Garamond", serif;
  font-weight: 300;
  font-size: clamp(100px, 19vw, 250px);
  letter-spacing: .16em;
  line-height: .8;
  padding-left: .16em;
}

.hero-subtitle {
  margin-top: 35px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(20px, 3vw, 34px);
  font-style: italic;
  color: #e1d4c0;
  letter-spacing: .05em;
}

.hero-description {
  margin: 22px auto 0;
  max-width: 390px;
  font-size: 10px;
  line-height: 2;
  letter-spacing: .17em;
  text-transform: uppercase;
  color: rgba(255,255,255,.72);
}

.hero-button {
  display: inline-flex;
  margin-top: 42px;
  border: 1px solid rgba(238,233,223,.7);
  padding: 17px 35px;
  font-size: 9px;
  letter-spacing: .23em;
  text-transform: uppercase;
  transition: .4s;
}

.hero-button:hover {
  background: var(--cream);
  color: var(--black);
}

.hero-side {
  position: absolute;
  bottom: 35px;
  left: 6vw;
  z-index: 3;
  font-size: 8px;
  letter-spacing: .2em;
  color: #c5b9a6;
  text-transform: uppercase;
}

.hero-number {
  position: absolute;
  right: 6vw;
  bottom: 35px;
  z-index: 3;
  font-size: 9px;
  letter-spacing: .2em;
  color: #c5b9a6;
}

/* =========================
   INTRO
========================= */

.intro {
  padding: 150px 8vw;
  background: var(--cream);
  color: var(--black);
  text-align: center;
}

.eyebrow {
  font-size: 9px;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: #987c55;
  margin-bottom: 25px;
}

.intro h2 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(48px, 8vw, 100px);
  font-weight: 300;
  line-height: .95;
}

.intro h2 em {
  color: #947c5c;
}

.intro p {
  max-width: 520px;
  margin: 30px auto 0;
  color: #6c655b;
  font-size: 13px;
  line-height: 2;
}

/* =========================
   COLLECTION
========================= */

.collection {
  padding: 120px 6vw 150px;
  background: #171512;
}

.collection-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 65px;
}

.collection-heading h2 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(55px, 8vw, 105px);
  font-weight: 300;
  line-height: .9;
}

.collection-heading p {
  max-width: 260px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.9;
}

.fragrance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.fragrance-card {
  position: relative;
  overflow: hidden;
  background: #24201b;
  cursor: pointer;
}

.fragrance-image {
  height: 470px;
  overflow: hidden;
  position: relative;
}

.fragrance-image img {
  height: 100%;
  object-fit: cover;
  transition: transform 1s ease;
  filter: brightness(.83);
}

.fragrance-card:hover img {
  transform: scale(1.07);
  filter: brightness(1);
}

.fragrance-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.65),
    transparent 65%
  );
}

.fragrance-info {
  position: absolute;
  left: 25px;
  right: 25px;
  bottom: 25px;
  z-index: 2;
}

.fragrance-number {
  font-size: 9px;
  color: #d2bd9d;
  letter-spacing: .25em;
  margin-bottom: 12px;
}

.fragrance-info h3 {
  font-family: "Cormorant Garamond", serif;
  font-weight: 400;
  font-size: 42px;
}

.fragrance-info p {
  margin-top: 7px;
  font-size: 9px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: #e1d8ca;
}

.fragrance-details {
  padding: 24px;
}

.fragrance-details p {
  color: #aaa095;
  font-size: 11px;
  line-height: 1.8;
}

.fragrance-notes {
  margin-top: 18px;
  color: var(--gold);
  font-size: 9px;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.fragrance-link {
  display: inline-block;
  margin-top: 22px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--gold);
  font-size: 9px;
  letter-spacing: .2em;
  text-transform: uppercase;
}

/* =========================
   FIFTH SCENT
========================= */

.last-fragrance {
  margin-top: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #24201b;
}

.last-fragrance .fragrance-image {
  height: 500px;
}

.last-fragrance .fragrance-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8%;
}

.last-fragrance h3 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(45px, 6vw, 75px);
  font-weight: 300;
}

.last-fragrance p {
  margin-top: 20px;
  max-width: 400px;
  font-size: 12px;
  color: #aaa095;
  line-height: 2;
}

/* =========================
   CAMPAIGN
========================= */

.campaign {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 100px 20px;
  background:
    linear-gradient(rgba(0,0,0,.35),rgba(0,0,0,.55)),
    url("https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=2200&q=90")
    center/cover no-repeat;
}

.campaign-content {
  max-width: 750px;
}

.campaign h2 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(60px, 10vw, 125px);
  font-weight: 300;
  line-height: .9;
}

.campaign h2 em {
  color: #d3b98f;
}

.campaign p {
  margin: 30px auto 0;
  max-width: 420px;
  font-size: 11px;
  line-height: 2;
  letter-spacing: .1em;
  color: #e0d9cf;
}

/* =========================
   PHILOSOPHY
========================= */

.philosophy {
  background: var(--cream);
  color: var(--black);
  padding: 140px 8vw;
}

.philosophy-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
  align-items: center;
}

.philosophy-image {
  height: 650px;
  overflow: hidden;
}

.philosophy-image img {
  height: 100%;
  object-fit: cover;
}

.philosophy h2 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(55px, 7vw, 90px);
  font-weight: 300;
  line-height: .95;
}

.philosophy-copy {
  margin-top: 30px;
  color: #71685e;
  font-size: 13px;
  line-height: 2;
  max-width: 450px;
}

.signature {
  margin-top: 40px;
  font-family: "Cormorant Garamond", serif;
  font-size: 27px;
  font-style: italic;
  color: #987c55;
}

/* =========================
   FINAL STATEMENT
========================= */

.statement {
  padding: 130px 7vw;
  text-align: center;
  background: #171512;
}

.statement h2 {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(55px, 10vw, 125px);
  font-weight: 300;
  line-height: .95;
}

.statement p {
  margin-top: 25px;
  font-size: 9px;
  letter-spacing: .35em;
  color: var(--gold);
  text-transform: uppercase;
}

/* =========================
   FOOTER
========================= */

footer {
  padding: 70px 6vw 30px;
  background: #0c0b09;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: start;
  padding-bottom: 65px;
  border-bottom: 1px solid var(--line);
}

.footer-logo {
  font-family: "Cormorant Garamond", serif;
  font-size: 85px;
  letter-spacing: .2em;
  font-weight: 400;
}

.footer-tagline {
  color: #92887a;
  font-size: 11px;
  margin-top: 12px;
  letter-spacing: .1em;
}

.footer-links {
  display: flex;
  gap: 30px;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .17em;
}

.footer-links a:hover {
  color: var(--gold);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  padding-top: 25px;
  color: #766e64;
  font-size: 9px;
  letter-spacing: .1em;
}

/* =========================
   ANIMATIONS
========================= */

.reveal {
  opacity: 0;
  transform: translateY(35px);
  transition: opacity .9s ease, transform .9s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes heroAppear {
  from {
    opacity: 0;
    transform: translateY(25px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================
   MOBILE
========================= */

@media(max-width: 800px) {

  header {
    padding: 20px 6vw;
  }

  .logo {
    font-size: 32px;
  }

  .nav-links {
    display: none;
  }

  .nav-right {
    font-size: 8px;
  }

  .hero h1 {
    font-size: 105px;
  }

  .hero-kicker {
    font-size: 8px;
  }

  .hero-side,
  .hero-number {
    font-size: 7px;
  }

  .intro {
    padding: 100px 7vw;
  }

  .collection {
    padding: 90px 6vw;
  }

  .collection-heading {
    display: block;
  }

  .collection-heading p {
    margin-top: 25px;
  }

  .fragrance-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .fragrance-image {
    height: 350px;
  }

  .fragrance-info {
    left: 14px;
    right: 14px;
    bottom: 17px;
  }

  .fragrance-info h3 {
    font-size: 32px;
  }

  .fragrance-info p {
    font-size: 7px;
  }

  .fragrance-details {
    padding: 15px;
  }

  .fragrance-details p {
    font-size: 10px;
  }

  .fragrance-notes {
    font-size: 8px;
    line-height: 1.8;
  }

  .last-fragrance {
    grid-template-columns: 1fr;
  }

  .last-fragrance .fragrance-image {
    height: 380px;
  }

  .last-fragrance .fragrance-details {
    padding: 35px;
  }

  .campaign {
    min-height: 600px;
  }

  .philosophy {
    padding: 90px 7vw;
  }

  .philosophy-grid {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .philosophy-image {
    height: 450px;
  }

  .footer-top {
    display: block;
  }

  .footer-links {
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .footer-logo {
    font-size: 65px;
  }

  .footer-bottom {
    gap: 15px;
    flex-direction: column;
    align-items: flex-start;
  }

}

@media(max-width: 420px) {

  .hero h1 {
    font-size: 85px;
  }

  .fragrance-grid {
    grid-template-columns: 1fr;
  }

  .fragrance-image {
    height: 440px;
  }

  .fragrance-info h3 {
    font-size: 40px;
  }

  .philosophy-image {
    height: 370px;
  }

}

</style>
</head>

